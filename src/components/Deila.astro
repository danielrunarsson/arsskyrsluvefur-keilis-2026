---
// „Deila“-valmynd: Facebook, X, tölvupóstur og „Afrita hlekk“; í síma líka „Fleiri leiðir…“
// (deilivalmynd tækisins). Tenglarnir eru reiknaðir við build úr canonical-slóð síðunnar, svo
// Facebook/X/tölvupóstur virka án JavaScript (<details>). Engar rakningarskriftur eru hlaðnar.
interface Props {
  titill: string;
  /** Hægri-jöfnuð valmynd (þegar hnappurinn er hægra megin). */
  haegri?: boolean;
  class?: string;
}
const { titill, haegri = false, class: klasi } = Astro.props;
const slod = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.href;
const k = encodeURIComponent;
const tenglar = {
  facebook: `https://www.facebook.com/sharer/sharer.php?u=${k(slod)}`,
  x: `https://x.com/intent/post?url=${k(slod)}&text=${k(titill)}`,
  postur: `mailto:?subject=${k(titill)}&body=${k(`${titill}\n\n${slod}`)}`,
};
---

<details class:list={['deila', { 'deila--haegri': haegri }, klasi]} data-pagefind-ignore data-deila data-slod={slod} data-titill={titill}>
  <summary class="deila__hnappur">
    <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
      <path d="M8 1.5v8.5M4.8 4.6 8 1.4l3.2 3.2M3 7.5v6.5h10V7.5" fill="none" stroke="currentColor" stroke-width="1.5" />
    </svg>
    <span>Deila</span>
  </summary>
  <ul class="deila__valmynd">
    <li class="deila__tenging" hidden>
      <button type="button" class="deila__atridi" data-deila-taeki>
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><circle cx="3.5" cy="8" r="1.4" /><circle cx="8" cy="8" r="1.4" /><circle cx="12.5" cy="8" r="1.4" /></svg>
        Fleiri leiðir…
      </button>
    </li>
    <li>
      <a class="deila__atridi" href={tenglar.facebook} target="_blank" rel="noopener">
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M9.2 15V8.7h2.1l.3-2.5H9.2V4.7c0-.7.2-1.2 1.2-1.2h1.3V1.3A17 17 0 0 0 9.8 1.2C8 1.2 6.7 2.3 6.7 4.4v1.8H4.6v2.5h2.1V15z" fill="currentColor" /></svg>
        Facebook<span class="sr-only"> (opnast í nýjum flipa)</span>
      </a>
    </li>
    <li>
      <a class="deila__atridi" href={tenglar.x} target="_blank" rel="noopener">
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M12.2 1.5h2.2L9.6 7l5.7 7.5h-4.5L7.3 9.9l-4 4.6H1.1l5.2-5.9L.9 1.5h4.6l3.2 4.2zm-.8 11.7h1.2L4.7 2.7H3.4z" fill="currentColor" /></svg>
        X<span class="sr-only"> (opnast í nýjum flipa)</span>
      </a>
    </li>
    <li>
      <a class="deila__atridi" href={tenglar.postur}>
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M1.5 3.5h13v9h-13zM1.8 3.8 8 8.6l6.2-4.8" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
        Tölvupóstur
      </a>
    </li>
    <li class="deila__afrita-li" hidden>
      <button type="button" class="deila__atridi" data-deila-afrita>
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M6.6 9.4a3 3 0 0 0 4.2 0l2.6-2.6a3 3 0 0 0-4.2-4.2l-.9.9M9.4 6.6a3 3 0 0 0-4.2 0L2.6 9.2a3 3 0 0 0 4.2 4.2l.9-.9" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
        <span class="deila__afrita-texti">Afrita hlekk</span>
      </button>
    </li>
  </ul>
  <span class="sr-only" role="status" aria-live="polite" data-deila-stada></span>
</details>

<style is:global>
  .deila {
    position: relative;
    display: inline-block;
  }
  .deila > summary {
    list-style: none;
  }
  .deila > summary::-webkit-details-marker {
    display: none;
  }
  .deila__hnappur {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border: 1px solid var(--blek);
    background: #fff;
    color: var(--blek);
    font: 600 13px var(--sans);
    letter-spacing: 0.02em;
    cursor: pointer;
    user-select: none;
  }
  .deila__hnappur:hover,
  .deila[open] > .deila__hnappur {
    color: var(--gull-dokkt);
    border-color: var(--gull-dokkt);
  }
  .deila__hnappur:focus-visible {
    outline: 2px solid var(--gull-dokkt);
    outline-offset: 3px;
  }
  .deila__valmynd {
    position: absolute;
    z-index: 30;
    top: calc(100% + 6px);
    left: 0;
    min-width: 210px;
    margin: 0;
    padding: 6px 0;
    list-style: none;
    background: #fff;
    border: 1px solid var(--blek);
    box-shadow: 0 8px 24px rgba(21, 19, 15, 0.12);
  }
  .deila--haegri .deila__valmynd {
    left: auto;
    right: 0;
  }
  .deila__atridi {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    padding: 11px 16px;
    border: 0;
    background: none;
    color: var(--blek);
    font: 500 15px var(--sans);
    text-align: left;
    cursor: pointer;
  }
  .deila__atridi svg {
    flex: none;
    color: var(--gull-dokkt);
  }
  .deila__atridi:hover,
  .deila__atridi:focus-visible {
    background: var(--gull-ljost);
    color: var(--blek);
    outline: none;
  }
</style>

<script>
  for (const d of document.querySelectorAll<HTMLDetailsElement>('[data-deila]')) {
    const slod = d.dataset.slod || location.href;
    const titill = d.dataset.titill || document.title;
    const stada = d.querySelector<HTMLElement>('[data-deila-stada]')!;

    // Afrita hlekk (ef klippiborð er í boði)
    if (navigator.clipboard) {
      const li = d.querySelector<HTMLElement>('.deila__afrita-li')!;
      const texti = li.querySelector<HTMLElement>('.deila__afrita-texti')!;
      li.hidden = false;
      li.querySelector('button')!.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(slod);
          texti.textContent = 'Hlekkur afritaður ✓';
          stada.textContent = 'Hlekkur afritaður';
        } catch {
          texti.textContent = 'Gat ekki afritað';
        }
        setTimeout(() => {
          texti.textContent = 'Afrita hlekk';
          d.open = false;
        }, 1400);
      });
    }

    // Deilivalmynd tækisins (síma)
    if (typeof navigator.share === 'function' && matchMedia('(pointer: coarse)').matches) {
      const li = d.querySelector<HTMLElement>('.deila__tenging')!;
      li.hidden = false;
      li.querySelector('button')!.addEventListener('click', async () => {
        d.open = false;
        try {
          await navigator.share({ title: titill, url: slod });
        } catch {
          /* hætt við */
        }
      });
    }

    // Lokast við smell á tengil, smell utan valmyndar og Esc.
    d.querySelectorAll('a.deila__atridi').forEach((a) => a.addEventListener('click', () => (d.open = false)));
    document.addEventListener('click', (e) => {
      if (d.open && !d.contains(e.target as Node)) d.open = false;
    });
    d.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && d.open) {
        d.open = false;
        d.querySelector<HTMLElement>('summary')?.focus();
      }
    });
  }
</script>
