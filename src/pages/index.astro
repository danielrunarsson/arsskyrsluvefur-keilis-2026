---
import Grunnur from '../layouts/Grunnur.astro';
import Haus from '../components/Haus.astro';
import Fotur from '../components/Fotur.astro';
import Mynd from '../components/Mynd.astro';
import Studningsadilar from '../components/Studningsadilar.astro';
import { efni, kaflar, sidur, slod } from '../lib/skyrsla.js';
import { linurFyrirsagnar } from '../lib/fyrirsogn.js';

const fs = efni.forsida;
const fyrirsogn = linurFyrirsagnar(fs.fyrirsogn, fs.fyrirsognSkaletrun);
const avarp = sidur[0] ? slod(sidur[0].slug) : null;
const greinar = fs.greinar.map((g: any) => ({ ...g, href: slod(g.slug) }));
---

<Grunnur deilikort="forsida">
  <Haus gerd="forsida" />

  <section aria-label="Um ársskýrsluna">
    <div class="upplysingar">
      <span>{efni.heiti}</span>
      <span class="upplysingar__mid">Golfklúbburinn Keilir · Hafnarfirði</span>
      <span class="upplysingar__adalfundur">{efni.adalfundur}</span>
    </div>
  </section>

  <main id="efni" tabindex="-1">
    <section class="hetja">
      <h1 class="hetja__fyrirsogn">
        <span class="hetja__fyrirsogn-texti" style={`--breidd:${fyrirsogn.breidd}`}>
          {
            fyrirsogn.linur.map((lina: any, n: number) => (
              <>
                {n > 0 && ' '}
                <span class="hetja__lina">
                  {lina.map((h: any) => (h.skaletrad ? <em class:list={{ 'hetja__samfellt': h.samfellt }}>{h.texti}</em> : h.texti))}
                </span>
              </>
            ))
          }
        </span>
      </h1>
      <div class="hetja__inngangur">
        <p>{fs.inngangur}</p>
        {avarp && <a class="tengill-strik" href={avarp}>Lesa ávarp formanns →</a>}
      </div>
    </section>

    {
      fs.mynd && (
        <figure class="adalmynd">
          <Mynd src={fs.mynd} alt={fs.myndAlt || fs.myndatexti} class="adalmynd__img" eager forgangur />
          {fs.myndatexti && <figcaption class="myndatexti">{fs.myndatexti}</figcaption>}
        </figure>
      )
    }

    <dl class="lykiltolur">
      {
        fs.lykiltolur.map((l: any) => (
          <div class="lykiltolur__item">
            <dt class="lykiltolur__tala" data-telja>{l.tala}</dt>
            <dd class="lykiltolur__texti">
              {l.texti}
              <br />
              <span class="lykiltolur__breyting" data-telja>{l.breyting}</span>
            </dd>
          </div>
        ))
      }
    </dl>

    <section class="efnisyfirlit" aria-labelledby="efnisyfirlit">
      <div class="efnisyfirlit__haus">
        <div class="yfirmerking">Í þessu hefti</div>
        <h2 id="efnisyfirlit" class="efnisyfirlit__titill">Efnisyfirlit</h2>
      </div>
      <ol class="efnisyfirlit__listi">
        {
          kaflar.map((k) => (
            <li>
              <a href={k.href}>
                <span class="efnisyfirlit__nr">{k.nr}</span>
                <span class="efnisyfirlit__heiti">{k.heiti}</span>
                <span class="efnisyfirlit__sidur">{k.sidurTexti}</span>
                <span class="efnisyfirlit__or" aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="greinar" aria-label="Valdar greinar">
      {
        greinar.map((g: any) => {
          const Tag = g.href ? 'a' : 'div';
          return (
            <Tag class="grein" href={g.href ?? undefined}>
              <Mynd src={g.mynd} alt={g.alt} class="grein__img" sizes="(min-width: 900px) 430px, calc(100vw - 40px)" widths={[480, 640, 720, 860, 1200]} />
              <div class="grein__kicker">{g.kicker}</div>
              <h3 class="grein__titill">{g.titill}</h3>
              <p class="grein__texti">{g.texti}</p>
              {g.href && <span class="grein__meira">Lesa meira →</span>}
            </Tag>
          );
        })
      }
    </section>

    <section class="studningsadilar" aria-labelledby="studningsadilar">
      <h2 id="studningsadilar" class="studningsadilar__titill">Stuðningsaðilar Keilis</h2>
      <Studningsadilar nofn={fs.studningsadilar} />
    </section>
  </main>

  <Fotur gerd="forsida" />
</Grunnur>
