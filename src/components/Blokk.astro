---
// Ein efnisblokk úr efnisskránni (b.t ræður gerð). Sjá README fyrir lýsingu á hverri gerð.
import Mynd from './Mynd.astro';
import Sulurit from './Sulurit.astro';
import Fjarmalagraf from './Fjarmalagraf.astro';
import Texti from './Texti.astro';
import { slod } from '../lib/skyrsla.js';
import { skjalStaerd } from '../lib/skjol.js';

// stig: fyrirsagnastig smáfyrirsagna (2 ef ekkert h2 er komið á undan á síðunni, annars 3).
// samhengi: síðasta h2 á undan – gefur töflum nafn fyrir skjálesara.
const { b, stig = 3, samhengi } = Astro.props as { b: any; stig?: 2 | 3; samhengi?: string };
const H = stig === 2 ? 'h2' : 'h3';

// Forskoðun PDF-skjals (fyrsta síða, búin til með `npm run pdf-forskodun`), fundin eftir
// skráarheiti svo hún virki hvort sem src er ytri slóð eða staðbundin (/skjol/…).
const forskodanir = Object.keys(import.meta.glob('../assets/pdf-forskodun/*.png'));
const pdfNafn = b.t === 'pdf' ? String(b.src).split(/[?#]/)[0].split('/').pop()!.replace(/\.pdf$/i, '') : '';
const pdfForskodun = pdfNafn && forskodanir.includes(`../assets/pdf-forskodun/${pdfNafn}.png`) ? `pdf-forskodun/${pdfNafn}.png` : null;

// Myndband: rammi í réttum hlutföllum, lesinn úr forsíðumynd (poster) við build –
// ferkantað, lárétt og lóðrétt myndband birtist þá óskorið.
let myndbandHlutfall: { b: number; h: number } | null = null;
if (b.t === 'myndband' && typeof b.poster === 'string' && b.poster.startsWith('/')) {
  try {
    const { default: sharp } = await import('sharp');
    const m = await sharp(`public${b.poster}`).metadata();
    if (m.width && m.height) myndbandHlutfall = { b: m.width, h: m.height };
  } catch {
    // Engin forsíðumynd fannst: eldri hegðun (16:9, eða 9:16 með lodrett).
  }
}

const tafla =
  b.t === 'tafla'
    ? {
        dalkar: b.dalkar.length,
        texti: b.snid === 'texti', // textatafla: vinstrijöfnuð, tölur telja ekki upp
        radir: b.radir.map((r: any) => (Array.isArray(r) ? { c: r } : r)),
      }
    : null;
const tenglar = (b.t === 'undirsidur' || b.t === 'tenglar' ? b.atridi : [])
  .map((a: any) => ({ ...a, href: slod(a.slug) }))
  .filter((a: any) => a.href);
---

{b.t === 'inngangur' && <p class="b-inngangur">{b.texti}</p>}

{
  b.t === 'p' && (
    <p class="b-p">
      <Texti texti={b.texti} />
    </p>
  )
}

{b.t === 'h2' && <h2 class="b-h2">{b.texti}</h2>}

{b.t === 'h3' && <H class="b-h3">{b.texti}</H>}

{
  b.t === 'listi' && (
    <ul class="b-listi">
      {b.atridi.map((a: string) => (
        <li>
          {/* Textinn í einn reit: annars verður hver feitletraður bútur sér grindarreitur. */}
          <span>
            <Texti texti={a} />
          </span>
        </li>
      ))}
    </ul>
  )
}

{
  b.t === 'tolur' && (
    <dl class="b-tolur">
      {b.atridi.map((a: any) => (
        <div>
          <dt data-telja>{a.tala}</dt>
          <dd>{a.texti}</dd>
        </div>
      ))}
    </dl>
  )
}

{
  b.t === 'tilvitnun' && (
    <blockquote class="b-tilvitnun">„{b.texti}“</blockquote>
  )
}

{
  b.t === 'mynd' && (
    <figure class="b-mynd">
      <Mynd src={b.src} alt={b.alt || b.texti} class="b-mynd__img" sizes="(min-width: 900px) 992px, calc(100vw - 40px)" widths={[480, 640, 800, 1000, 1400, 2000]} />
      {b.texti && <figcaption class="myndatexti">{b.texti}</figcaption>}
    </figure>
  )
}

{
  b.t === 'myndir' && (
    <div class="b-myndir">
      {b.atridi.map((a: string | { src: string; alt?: string }) => (
        <Mynd
          src={typeof a === 'string' ? a : a.src}
          alt={typeof a === 'string' ? undefined : a.alt}
          class="b-myndir__img"
          sizes="(min-width: 900px) 488px, calc(100vw - 40px)"
        />
      ))}
    </div>
  )
}

{
  b.t === 'myndband' && (
    <figure class="b-myndband">
      <video
        src={b.src}
        poster={b.poster}
        controls
        preload="metadata"
        playsinline
        width={myndbandHlutfall?.b}
        height={myndbandHlutfall?.h}
        style={myndbandHlutfall ? `aspect-ratio:${myndbandHlutfall.b} / ${myndbandHlutfall.h};--hlutfall:${(myndbandHlutfall.b / myndbandHlutfall.h).toFixed(4)}` : undefined}
        class:list={[
          'b-myndband__video',
          { 'b-myndband__video--hlutfall': myndbandHlutfall, 'b-myndband__video--lodrett': b.lodrett && !myndbandHlutfall },
        ]}
      />
      <figcaption class="myndatexti">▶ {b.texti}</figcaption>
    </figure>
  )
}

{
  tafla && (
    <div class="b-tafla-ytri">
    <div class="b-tafla__visbending" aria-hidden="true">Strjúktu til hliðar →</div>
    <div class="b-tafla" role="region" aria-label={b.titill ?? (samhengi ? `${samhengi} – tafla` : 'Tafla')} tabindex="0">
      <table class:list={['tafla', `tafla--${tafla.dalkar}`, { 'tafla--texti': tafla.texti }]}>
        <thead>
          <tr>
            {b.dalkar.map((d: string) => (
              <th scope="col">{d || <span class="sr-only">Liður</span>}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {tafla.radir.map((r: any) =>
            r.milli ? (
              <tr class="tafla__milli">
                <th colspan={tafla.dalkar} scope="colgroup">
                  {r.c[0]}
                </th>
              </tr>
            ) : (
              <tr class:list={{ tafla__feitt: r.feitt, tafla__samtala: r.samtala }}>
                {r.c.map((v: string, i: number) => (i === 0 ? <th scope="row">{v}</th> : tafla.texti ? <td>{v}</td> : <td data-telja>{v}</td>))}
              </tr>
            ),
          )}
        </tbody>
      </table>
    </div>
    <span class="b-tafla__fade" aria-hidden="true" />
    </div>
  )
}

{
  b.t === 'sulur' && <Sulurit b={b} />

}

{['flogg', 'skorkort', 'foss', 'skipting', 'arasulur', 'skref'].includes(b.t) && <Fjarmalagraf b={b} />}

{
  /* Tveir dálkar hlið við hlið á breiðum skjá (texti | kort), hvor undir öðrum á síma.
     Fyrirsagnir inni í dálkum: h2 helst h2, smáfyrirsagnir verða h3. */
  b.t === 'tvidalka' && (
    <div class:list={['b-tvidalka', { 'b-tvidalka--jafnt': b.jafnt }]}>
      {[b.vinstri, b.haegri].map((dalkur: any[] = []) => (
        <div class="b-tvidalka__dalkur">
          {dalkur.map((x: any) => (
            <Astro.self b={x} stig={3} samhengi={[...(b.vinstri ?? []), ...(b.haegri ?? [])].find((y: any) => y.t === 'h2')?.texti ?? samhengi} />
          ))}
        </div>
      ))}
    </div>
  )
}

{
  b.t === 'pdf' && (
    <div class="b-pdf">
      {pdfForskodun ? (
        <a class="b-pdf__forskodun b-pdf__forskodun--mynd rendur" href={b.src} target="_blank" rel="noopener">
          <Mynd src={pdfForskodun} alt={`Fyrsta síða: ${b.titill}`} sizes="340px" widths={[320, 600]} class="b-pdf__sida" />
          <span class="sr-only">(PDF, opnast í nýjum flipa)</span>
        </a>
      ) : (
        <div class="b-pdf__forskodun rendur">PDF-forskoðun · {b.titill}</div>
      )}
      <div class="b-pdf__hlid">
        <div class="b-pdf__lysing">
          <span class="merking-gull">Skjal</span>
          <span class="b-pdf__titill">{b.titill}</span>
        </div>
        <div class="b-pdf__hnappar">
          <a class="hnappur hnappur--breidd" href={b.src} download>
            Sækja · {skjalStaerd(b.src, b.staerd)}
          </a>
          <a class="b-pdf__opna" href={b.src} target="_blank" rel="noopener">
            Opna í nýjum flipa ↗
          </a>
        </div>
      </div>
    </div>
  )
}

{
  b.t === 'folk' && (
    <section class="b-folk">
      <H class="b-folk__titill">{b.titill}</H>
      <dl class="b-folk__listi">
        {b.atridi.map((a: any) => (
          <div>
            <dt>{a.nafn}</dt>
            <dd>{a.hlutverk}</dd>
          </div>
        ))}
      </dl>
    </section>
  )
}

{
  b.t === 'nofn' && (
    <section class="b-nofn">
      <H class="b-nofn__titill">{b.titill}</H>
      <ul class="b-nofn__listi">
        {b.atridi.map((n: string) => (
          <li>{n}</li>
        ))}
      </ul>
    </section>
  )
}

{
  b.t === 'nefndir' && (
    <div class="b-nefndir">
      {b.atridi.map((a: any) => (
        <div class="b-nefndir__kort">
          <H>{a.heiti}</H>
          <p>{a.texti}</p>
        </div>
      ))}
    </div>
  )
}

{
  b.t === 'grof' && (
    <div class="b-grof">
      {b.atridi.map((a: any) => (
        <figure class="b-grof__item">
          <figcaption class="merking-gull">{a.heiti}</figcaption>
          <Mynd src={a.src} alt={a.alt || a.heiti} class="b-grof__img" sizes="(min-width: 900px) 480px, calc(100vw - 40px)" widths={[400, 640, 960]} />
        </figure>
      ))}
    </div>
  )
}

{
  b.t === 'undirsidur' && tenglar.length > 0 && (
    <div class="b-undirsidur">
      {tenglar.map((a: any) => (
        <a href={a.href}>
          <span class="b-undirsidur__heiti">{a.heiti}</span>
          <span class="b-undirsidur__meira">Sjá nánar →</span>
        </a>
      ))}
    </div>
  )
}

{
  b.t === 'tenglar' && tenglar.length > 0 && (
    <div class="b-tenglar">
      {tenglar.map((a: any) => (
        <a href={a.href}>{a.heiti} →</a>
      ))}
    </div>
  )
}

{
  b.t === 'undirskrift' && (
    <div class="b-undirskrift">
      <span class="b-undirskrift__nafn">{b.nafn}</span>
      <span class="b-undirskrift__titill">{b.titill}</span>
    </div>
  )
}
