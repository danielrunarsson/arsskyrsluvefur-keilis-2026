---
// Innra veftré: allar síður og staða efnis. Aðeins byggt þegar síður án efnis
// eru sýndar (dev og prufu-deploy), aldrei í production.
import Grunnur from '../../layouts/Grunnur.astro';
import { efni, fjoldi, synaVantar, slod } from '../../lib/skyrsla.js';

export function getStaticPaths() {
  return synaVantar ? [{ params: { sida: 'veftre' } }] : [];
}

const kaflar = efni.kaflar.map((k: any, i: number) => ({
  ...k,
  nr: String(i + 1).padStart(2, '0'),
  sidur: efni.sidur.filter((s: any) => s.kafli === k.id),
}));
const vantar = (s: any) => s.stada === 'vantar' || !s.blokkir?.length;
---

<Grunnur titill="Veftré" noindex>
  <main class="veftre">
    <header class="veftre__haus">
      <h1>{efni.heiti} · veftré</h1>
      <dl class="veftre__fjoldi">
        <div><dt class="gull">{fjoldi.sidur}</dt><dd>síður alls</dd></div>
        <div><dt>{fjoldi.sidur - fjoldi.vantar}</dt><dd>með efni</dd></div>
        <div><dt class="ljost">{fjoldi.vantar}</dt><dd>vantar efni</dd></div>
      </dl>
    </header>
    <div class="veftre__kaflar">
      {
        kaflar.map((k: any) => (
          <section>
            <h2>{k.nr} · {k.heiti}</h2>
            {k.sidur.map((s: any) => (
              <a href={slod(s.slug)} class="veftre__sida">
                <span class:list={['veftre__punktur', { 'veftre__punktur--vantar': vantar(s) }]} />
                <span>{s.heiti}</span>
                <span class="veftre__merki">{vantar(s) ? '—' : s.blokkir.length}</span>
              </a>
            ))}
          </section>
        ))
      }
    </div>
  </main>
</Grunnur>
