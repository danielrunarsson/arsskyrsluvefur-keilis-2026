---
import '../styles/global.css';
import { efni, synaVantar } from '../lib/skyrsla.js';

interface Props {
  titill?: string;
  lysing?: string;
  noindex?: boolean;
  /** Slug deilikorts: /deiling/<deilikort>.jpg */
  deilikort?: string;
  tegund?: 'website' | 'article';
}
const { titill, lysing: lysingInn = efni.forsida.inngangur, noindex = false, deilikort, tegund = 'website' } = Astro.props;
const fullurTitill = titill ? `${titill} · ${efni.heiti} · Golfklúbburinn Keilir` : `${efni.heiti} · Golfklúbburinn Keilir`;
const deiliTitill = titill ? `${titill} – ${efni.heiti} Keilis` : `${efni.heiti} – Golfklúbburinn Keilir`;
// Lýsing: hrein, stutt (≤ 200 stafir, klippt á orðaskilum).
const hrein = String(lysingInn).replace(/\*\*/g, '').replace(/\s+/g, ' ').trim();
const lysing = hrein.length > 200 ? hrein.slice(0, 197).replace(/\s+\S*$/, '') + '…' : hrein;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const deilimynd = deilikort && Astro.site ? new URL(`/deiling/${deilikort}.jpg`, Astro.site).href : undefined;
---

<!doctype html>
<html lang="is">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullurTitill}</title>
    <meta name="description" content={lysing} />
    <meta name="theme-color" content="#FFFFFF" />
    {(noindex || synaVantar) && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}

    <!-- Deiling: Facebook, LinkedIn, Slack, Messenger o.fl. -->
    <meta property="og:type" content={tegund} />
    <meta property="og:site_name" content={`${efni.heiti} · Golfklúbburinn Keilir`} />
    <meta property="og:locale" content="is_IS" />
    <meta property="og:title" content={deiliTitill} />
    <meta property="og:description" content={lysing} />
    {canonical && <meta property="og:url" content={canonical} />}
    {deilimynd && <meta property="og:image" content={deilimynd} />}
    {deilimynd && <meta property="og:image:type" content="image/jpeg" />}
    {deilimynd && <meta property="og:image:width" content="1200" />}
    {deilimynd && <meta property="og:image:height" content="630" />}
    {deilimynd && <meta property="og:image:alt" content={deiliTitill} />}
    <!-- X / Twitter -->
    <meta name="twitter:card" content={deilimynd ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={deiliTitill} />
    <meta name="twitter:description" content={lysing} />
    {deilimynd && <meta name="twitter:image" content={deilimynd} />}
    {deilimynd && <meta name="twitter:image:alt" content={deiliTitill} />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <script is:inline>
      // Felur tölur sem eiga að telja upp þar til hreyfing.ts hefur núllstillt þær (öryggistími 2,5 s).
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        var h = document.documentElement;
        h.classList.add('hreyfing');
        setTimeout(function () { h.classList.add('hreyfing-tilbuin'); }, 2500);
      }
    </script>
    <link rel="preload" href="/fonts/newsreader.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <div class="sida">
      <slot />
    </div>
    <script>
      import '../scripts/hreyfing.ts';
    </script>
  </body>
</html>
