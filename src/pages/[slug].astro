---
import Grunnur from '../layouts/Grunnur.astro';
import Haus from '../components/Haus.astro';
import Fotur from '../components/Fotur.astro';
import Mynd from '../components/Mynd.astro';
import Blokk from '../components/Blokk.astro';
import Langlestur from '../components/Langlestur.astro';
import NaestaSpjald from '../components/NaestaSpjald.astro';
import Deila from '../components/Deila.astro';
import Lesframvinda from '../components/Lesframvinda.astro';
import { sidur, sidaMeta, slod } from '../lib/skyrsla.js';

export function getStaticPaths() {
  return sidur.map((s) => ({ params: { slug: s.slug } }));
}

const { slug } = Astro.params;
const { sida: s, kafli, fyrirsogn, kicker, fyrri, naestaSida } = sidaMeta(slug);
const allarBlokkir = s.blokkir.flatMap((b: any) => (b.t === 'hluti' ? [...(b.blokkir ?? []), ...(b.vinstri ?? []), ...(b.haegri ?? []), ...(b.eftir ?? [])] : [b]));
const inngangur = allarBlokkir.find((b: any) => b.t === 'inngangur')?.texti;
const langlestur = s.snid === 'langlestur' && !s.vantar;
// Heilsíða: síðan byggð í breiðum böndum (`hluti`) án hliðarvalmyndar, t.d. fjármálayfirlitið.
// Fyrsta bandið með snid „hetja“ verður haus síðunnar (yfirmerking, fyrirsögn og Deila efst í vinstri dálki).
const heilsida = s.snid === 'heilsida' && !s.vantar;
const hetja = heilsida && s.blokkir[0]?.t === 'hluti' && s.blokkir[0]?.snid === 'hetja' ? s.blokkir[0] : null;
// Samhengi hverrar blokkar: smáfyrirsagnir verða h2 þar til fyrsta h2 kemur (rétt fyrirsagnaröð),
// og töflur fá nafn síðasta h2 á undan.
let sidastaH2: string | undefined;
const blokkir = s.blokkir.map((b: any) => {
  if (b.t === 'h2') sidastaH2 = b.texti;
  if (b.t === 'hluti') sidastaH2 = [...(b.blokkir ?? []), ...(b.vinstri ?? [])].find((x: any) => x.t === 'h2')?.texti ?? sidastaH2;
  return { b, stig: (sidastaH2 ? 3 : 2) as 2 | 3, samhengi: sidastaH2 ?? s.heiti };
});
// Fyrirsögn í gæsalöppum: lokagæsalappir koma á eftir skáletraða hlutanum.
const lokagaesalappir = s.fyrirsognSkaletrun && fyrirsogn.startsWith('„') ? '“' : '';
// Lengsta orð titilsins: CSS minnkar letrið ef það kæmist annars ekki fyrir (engin skipting inni í orði).
const lengsta = Math.max(...`${fyrirsogn} ${s.fyrirsognSkaletrun ?? ''}${lokagaesalappir}`.split(/\s+/).map((o) => [...o].length));
---

<Grunnur titill={s.heiti} lysing={inngangur ?? s.fyrirsogn ?? s.heiti} deilikort={s.slug} tegund="article">
  <Haus gerd="undirsida" kafliId={kafli.id} slug={s.slug} />
  {!s.vantar && <Lesframvinda langlestur={langlestur} />}

  <div class:list={['systur-ytri', { 'systur-ytri--alltaf': heilsida }]}>
    <span class="systur__dofnun systur__dofnun--vinstri" aria-hidden="true">‹</span>
    <nav class="systur systur--farsimi" aria-label={`Síður í kaflanum ${kafli.heiti}`}>
      {
        kafli.sidur.map((y: any) => (
          <a href={slod(y.slug)} aria-current={y.slug === s.slug ? 'page' : undefined}>
            {y.heiti}
          </a>
        ))
      }
    </nav>
    <span class="systur__dofnun systur__dofnun--haegri" aria-hidden="true">›</span>
  </div>

  {heilsida && (
  <main id="efni" tabindex="-1" data-pagefind-body class="heilsida">
    {hetja && (
      <header class="hluti hluti--dokkt hluti--hetja">
        <div class="hluti__innra">
          <div class="b-tvidalka">
            <div class="b-tvidalka__dalkur">
              <div class="yfirmerking yfirmerking--gull">{kicker}</div>
              <h1 class="hluti__fyrirsogn">
                {fyrirsogn}
                {s.fyrirsognSkaletrun && <em>{s.fyrirsognSkaletrun}</em>}
              </h1>
              {(hetja.vinstri ?? []).map((x: any) => <Blokk b={x} stig={2} samhengi={s.heiti} />)}
              <Deila titill={s.heiti} />
            </div>
            <div class="b-tvidalka__dalkur">
              {(hetja.haegri ?? []).map((x: any) => <Blokk b={x} stig={2} samhengi={s.heiti} />)}
            </div>
          </div>
        </div>
      </header>
    )}
    {blokkir.filter(({ b }: any) => b !== hetja).map(({ b, stig, samhengi }: any) => <Blokk b={b} stig={stig} samhengi={samhengi} />)}
    <div class="hluti"><div class="hluti__innra">
      <NaestaSpjald fyrri={fyrri} naestaSida={naestaSida} kafliId={kafli.id} />
    </div></div>
  </main>
  )}

  {!heilsida && (
  <main id="efni" tabindex="-1" data-pagefind-body>
    {
      s.portrett ? (
        <header class="sidu-haus sidu-haus--portrett">
          <div class="sidu-haus__texti">
            <div class="yfirmerking yfirmerking--gull">{kicker}</div>
            <h1 class:list={['sidu-haus__fyrirsogn sidu-haus__fyrirsogn--portrett', { 'sidu-haus__fyrirsogn--langlestur': langlestur }]} style={`--lengsta:${lengsta}`}>
              {fyrirsogn}
              {s.fyrirsognSkaletrun && <em>{s.fyrirsognSkaletrun}</em>}
              {lokagaesalappir}
            </h1>
            <div class="sidu-haus__hofundur">
              <Mynd src={s.portrett} skraut class="sidu-haus__avatar" sizes="56px" widths={[112]} eager />
              <span>
                {s.hofundur}
                {s.lestur && <span class="sidu-haus__lestur"> · {s.lestur} lestur</span>}
              </span>
            </div>
            <Deila titill={s.heiti} />
          </div>
          <Mynd
            src={s.portrett}
            alt={s.portrettAlt || s.hofundur}
            class="sidu-haus__portrett"
            sizes="(min-width: 900px) 680px, 1px"
            widths={[680, 1360]}
            eager
          />
        </header>
      ) : (
        <header class="sidu-haus">
          <div class="yfirmerking yfirmerking--gull">{kicker}</div>
          <h1 class="sidu-haus__fyrirsogn" style={`--lengsta:${lengsta}`}>
            {fyrirsogn}
            {s.fyrirsognSkaletrun && <em>{s.fyrirsognSkaletrun}</em>}
            {lokagaesalappir}
          </h1>
          <Deila titill={s.heiti} />
        </header>
      )
    }

    {
      langlestur && (
        <Langlestur sida={s}>
          <NaestaSpjald fyrri={fyrri} naestaSida={naestaSida} kafliId={kafli.id} />
        </Langlestur>
      )
    }

    {!langlestur && (
    <div class="meginmal">
      <nav class="systur systur--hlid" aria-label={`Síður í kaflanum ${kafli.heiti}`}>
        <div class="systur__kafli">{kafli.heiti}</div>
        {
          kafli.sidur.map((y: any) => (
            <a href={slod(y.slug)} aria-current={y.slug === s.slug ? 'page' : undefined}>
              <span>{y.heiti}</span>
              {y.slug === s.slug && (
                <span class="systur__punktur" aria-hidden="true">
                  ●
                </span>
              )}
            </a>
          ))
        }
      </nav>

      <article class="blokkir">
        {
          s.vantar && (
            <div class="vantar rendur">
              <div class="vantar__merki">Efni vantar</div>
              <p class="vantar__texti">Síðan er tilbúin í sniðmátinu og fyllist þegar efnið er komið í efnisskrána.</p>
              <div class="vantar__heimild">
                Heimild: <a href={s.heimild}>{s.heimild}</a>
              </div>
            </div>
          )
        }
        {blokkir.map(({ b, stig, samhengi }: any) => <Blokk b={b} stig={stig} samhengi={samhengi} />)}

        <NaestaSpjald fyrri={fyrri} naestaSida={naestaSida} kafliId={kafli.id} />
      </article>
    </div>
    )}
  </main>
  )}

  <Fotur gerd="undirsida" />
</Grunnur>
