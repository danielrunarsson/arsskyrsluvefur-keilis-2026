---
// Birtir mynd úr efnisskránni. Staðbundnar myndir („myndir/…“) fara í gegnum
// astro:assets og verða AVIF/WebP í mörgum stærðum; ytri slóðir birtast óbreyttar.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: string;
  alt?: string;
  class?: string;
  sizes?: string;
  widths?: number[];
  eager?: boolean;
}

const myndir = import.meta.glob<ImageMetadata>('../assets/myndir/**/*.{jpg,jpeg,png,JPG,JPEG,PNG}', {
  eager: true,
  import: 'default',
});

const { src, alt = '', class: klasi, sizes = '(min-width: 900px) 1328px, 100vw', widths, eager = false } = Astro.props;
const stadbundin = myndir[`../assets/${src}`];
if (!stadbundin && !/^https?:\/\//.test(src)) {
  throw new Error(`Mynd fannst ekki: ${src} (á að vera í src/assets/${src})`);
}
const breiddir = (widths ?? [480, 800, 1200, 1600, 2400]).filter((w) => !stadbundin || w <= stadbundin.width);
if (stadbundin && !breiddir.length) breiddir.push(stadbundin.width);
const loading = eager ? 'eager' : 'lazy';
---

{
  stadbundin ? (
    <Picture
      src={stadbundin}
      alt={alt}
      formats={['avif', 'webp']}
      widths={breiddir}
      sizes={sizes}
      loading={loading}
      decoding="async"
      class={klasi}
    />
  ) : (
    <img src={src} alt={alt} loading={loading} decoding="async" class={klasi} />
  )
}
